<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:id="@+id/activity_manage_budget"
    android:background="@android:color/white">

    <Button
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back"
        android:textAllCaps="false"
        android:background="?attr/selectableItemBackground"
        android:textColor="#1B3BA2"
        android:layout_marginStart="8dp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <!-- Title -->
    <TextView
        android:id="@+id/manageBudgetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Manage Budget"
        android:textColor="#1B3BA2"
        android:textStyle="bold"
        android:textSize="22sp"
        android:layout_marginTop="24dp" />

    <!-- Circle Chart + Total planned expense -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:padding="12dp"
        android:background="@drawable/rounded_border_box">

        <!-- Pie Chart replacing static ImageView -->
        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/budgetPieChart"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center_vertical" />

        <!-- Expense Info -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total planned expense:"
                android:textColor="#1B3BA2"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/totalPlannedExpenseAmountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R: 0"
                android:textColor="#1B3BA2"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/totalBudgetAmountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your budget: R0"
                android:textColor="#1B3BA2"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/budgetProgressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0% of budget used"
                android:textSize="12sp"
                android:textColor="#000000"
                android:layout_marginBottom="8dp" />
            <ProgressBar
                android:id="@+id/budgetProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progress="0"
                android:max="100"
                android:layout_marginBottom="16dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Set Monthly Budget -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/setMonthlyBudgetButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/add"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Set Monthly Budget" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Set Monthly Budget"
            android:textColor="#1B3BA2"
            android:textStyle="bold" />
    </LinearLayout>


    <!-- Add Expense -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <!-- Add Expense Button -->
        <ImageButton
            android:id="@+id/addExpenseButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:backgroundTint="@color/blue"
            android:src="@drawable/add"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Set Monthly Budget" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Add Expense"
            android:textColor="#1B3BA2"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Expense Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/budget_card_background"
        android:padding="12dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Transport"
            android:textColor="#1B3BA2"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/transportAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R: 0"
            android:textColor="#1B3BA2"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>




</LinearLayout>
